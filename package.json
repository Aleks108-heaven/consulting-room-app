{
  "name": "consulting-room-app",
  "version": "1.0.0",
  "description": "Consulting Room — a study companion for the history of psychotherapy. Android + Windows builds of the single-file web app, with a provider-agnostic Live AI mode.",
  "private": true,
  "scripts": {
    "data:build": "node scripts/build-data.js",
    "ios:add": "cap add ios",
    "ios:sync": "cap sync ios",
    "android:add": "cap add android",
    "android:icon": "capacitor-assets generate --android --iconBackgroundColor \"#9C5A16\" --iconBackgroundColorDark \"#12191A\"",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:run": "cap run android",
    "win:dev": "tauri dev",
    "win:build": "tauri build"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/ios": "^6.1.2",
    "@tauri-apps/cli": "^2.1.0"
  },
  "dependencies": {
    "@capacitor/core": "^6.1.2"
  }
}
